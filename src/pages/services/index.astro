---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Callout from '../../components/Callout.astro';
import { services } from '../../data/pages';
import { u } from '../../lib/utils';
const title = 'Hydro Jetting Services in Manlius, NY';
const description = 'Hydro jetting for grease, roots, recurring clogs, mineral buildup and maintenance on drain and sewer lines in Manlius, New York.';
---
<Base title={title} description={description} path="/services/" crumbs={[{ name: 'Services', path: '/services/' }]}>
  <Hero headline="Hydro Jetting Services in Manlius, NY" intro="Each service page covers a different kind of blockage and when a closer look at the pipe matters." location="Services" crumbs={[{ href: '/services/', label: 'Services' }]} />
  <section class="content-section"><div class="content-inner">
    <div class="content-list">
      {services.map((s, i) => <a class="content-item" href={u(`/services/${s.slug}/`)} style="color:inherit;text-decoration:none"><div class="item-number">{String(i + 1).padStart(2, '0')}</div><div><h3>{s.name}</h3><p>{s.blurb}</p></div></a>)}
    </div>
  </div></section>
  <Callout />
</Base>
